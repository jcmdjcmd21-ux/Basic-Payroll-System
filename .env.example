# Copy this file to .env for local development. Never commit real credentials.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=payease
MYSQL_USER=payease_user
MYSQL_PASSWORD=replace_with_a_long_database_password
MYSQL_SSL_MODE=DISABLED
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_admin_password
